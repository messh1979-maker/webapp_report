APP_ENV=production
PORT=5700
SECRET_KEY=replace-with-at-least-64-random-characters
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
DATABASE_URL=postgresql+psycopg://energy:replace-db-password@db:5432/energy
SESSION_MINUTES=120
APP_TIMEZONE=Asia/Tehran
# 0: telecom hidden from non-admin users; 1: use each user's telecom permission
TELECOM_USER_VISIBLE=0
COOKIE_SECURE=1
TRUST_PROXY=1
WEB_CONCURRENCY=2
GUNICORN_THREADS=25
